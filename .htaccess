Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; font-src 'self' data: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; connect-src 'self' https: ws: wss:"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # Send HSTS only when served over HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]

  # Serve existing files/directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route backend endpoints when frontend and backend are deployed together.
  RewriteRule ^api/?$ backend/public/index.php?route=/api [L,QSA]
  RewriteRule ^api/(.*)$ backend/public/index.php?route=/api/$1 [L,QSA]

  RewriteRule ^uploads/?$ backend/public/router.php?asset=/uploads/ [L,QSA]
  RewriteRule ^uploads/(.*)$ backend/public/router.php?asset=/uploads/$1 [L,QSA]

  # Do not rewrite missing static assets to index.html
  RewriteCond %{REQUEST_URI} \.(?:js|mjs|css|map|json|txt|xml|svg|png|jpe?g|gif|webp|ico|woff2?|ttf|eot|mp4|webm|ogg)$ [NC]
  RewriteRule ^ - [R=404,L]

  # SPA fallback (React Router)
  RewriteRule . /index.html [L]
</IfModule>
