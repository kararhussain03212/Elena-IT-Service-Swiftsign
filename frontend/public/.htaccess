<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^api/?$ backend/public/index.php?route=/api [L,QSA]
  RewriteRule ^api/(.*)$ backend/public/index.php?route=/api/$1 [L,QSA]

  RewriteRule ^uploads/?$ backend/public/router.php [L,QSA]
  RewriteRule ^uploads/(.*)$ backend/public/router.php [L,QSA]

  RewriteRule ^admin/?$ admin/index.html [L]
  RewriteRule ^admin/(.*)$ admin/index.html [L]

  RewriteRule ^ index.html [L]
</IfModule>

Options -Indexes
